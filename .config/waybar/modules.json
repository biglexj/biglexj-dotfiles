{ 
    //Modules left

    // Rofi Application Launcher
    "custom/launcher": {
        "format": " ",
        "tooltip-format": "Left: Open the application launcher\nRight: Show all keybindings",
        "on-click": "rofi -show drun -replace",
        "on-click-right": "~/.config/biglexj/scripts/keybindings.sh",
        "tooltip": false
    },

    "custom/media": {
        "exec": "/home/biglexj/.config/waybar/scripts/mediaplayer.py",
        "interval": 5,
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "spotify": " ",
            "default": " "
        },
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "cpu": {
        "interval": 15,
        "format": "<span color='#f7768e'> </span> {}%",
        "max-length": 10
    },

    "disk": {
        "format": "<span color='#7dcfff'> </span> {used}",
        "interval": 1
    },

    "memory": {
        "interval": 30,
        "format": "<span color='#7dcfff'> </span> {used}%",
        "max-length": 10
    },

    // Hyprland Window
    "hyprland/window": {
        "rewrite": {
            "(.*) - Brave": "$1",
            "(.*) - Chromium": "$1",
            "(.*) - Brave Search": "$1",
            "(.*) - Outlook": "$1",
            "(.*) Microsoft Teams": "$1"
        },
        "separate-outputs": true
    },

    //Modules Center

    "hyprland/workspaces": {
		"disable-scroll": true,
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        },
        "format": "{icon}",
        "format-icons": {
            "active": "<span font='12'>󰮯</span>",
            "empty": "<span font='8'></span>",
            "persistent": "󰊠"
        }
    },

    //Modules Right

    // Network
    "network": {
        "format": "{ifname}",
        "format-wifi": "   {signalStrength}%",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "Not connected", //An empty format will hide the module.
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": "<span color='#9ece6a'> </span> {bandwidthDownBits}",
        "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "kitty -e nmtui"
    },

    // Pulseaudio
    "pulseaudio": {
        "tooltip": false,
        "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": "{icon} {volume}%",
        "format-source": "{volume}% <span color='#7aa2f7'></span>",
        "format-source-muted": "span color='#7aa2f7'>  </span>",
        "format-icons": {
            "headphone": "span color='#7aa2f7'>  </span>",
            "phone": "span color='#7aa2f7'>  </span>",
            "portable": "span color='#7aa2f7'>  </span>",
            "car": "span color='#7aa2f7'>  </span>",
            "default": [
                "<span color='#7aa2f7'> </span>",
                "<span color='#7aa2f7'> </span>",
                "<span color='#7aa2f7'> </span>"
            ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "~/.config/waybar/scripts/audio-switcher.sh"
    },

    "backlight": {
		"tooltip": false,
		"format": " {}%",
		"interval":1,
        "on-scroll-up": "light -A 5",
		"on-scroll-down": "light -U 5"
	},
    
    // Battery
    "battery": {
        "tooltip": true,
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰋠 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-good": "", // An empty format will hide the module
        "format-full": "",
        "format-icons": [" ", " ", " ", " ", " "]
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
          "default": "",
          "performance": "",
          "balanced": "",
          "power-saver": ""
        }
    },

    "bluetooth": {
        "format": "",
        "format-connected": " Conectado",
        "format-disconnected": " Desconectado",
        "format-pairing": " Emparejando...",
        "format-icons": {
            "default": "",
            "connected": "",
            "disconnected": ""
        },
        "on-click": "blueman-manager"
    },
    
    // Clock
    "clock": {
        // "timezone": "America/Lima",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },

    // System
    "custom/system": {
        "format": "",
        "tooltip": false
    },

    "custom/updates":{
        "format": "{} Update(s)",
        "exec": "checkupdates | wc -l",
        "exec-if": "[[ $(checkupdates | wc -l) != 0 ]]",
        "interval": 15,
        "on-click": "alacritty -e paru -Syu && notify-send 'The system has been updated' "
    },

        "custom/notification": {
        "format": "{}",
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -C -sw",
        "tooltip": false
    },

    "custom/power":{
        "format": "<span color='#f7768e'>⏻ </span>",
        "on-click": "wlogout"
    }
}
