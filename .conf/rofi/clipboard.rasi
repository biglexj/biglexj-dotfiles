@theme "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
    modi:                        "drun";
    show-icons:                  false;
  	drun-display-format:         "{name}";
}

* {
    font:                        "NDot57 Bold 15";
    background:                  transparent;
    background-alt:              rgba(0,0,0,0.2);
    foreground:                  white;
    selected:                    @selected-urgent-background;
    active:                      #909090;
    urgent:                      #e0e722;
}

window {
    width:                       1000;
    height:                      600;
    margin:                      0px;
    padding:                     0px;
    location: south;
    x-offset: 0;
    y-offset: -90;
}

mainbox {
    orientation:                 vertical;
    children:                    [ "inputbar", "textbox-help", "message", "listview" ];
    background-color:            transparent;

    spacing:                     16px;
    margin:                      0px;
    padding:                     70px;
}

inputbar {
    children:                    [ "dummy", "entry", "dummy" ];
    border-radius:               10px;

    spacing:                     0px;
    padding:                     35px 54px;
    orientation:                 horizontal;
    background-image:            url("/mnt/ntfs/Imágenes/Pictures/16.09/KANOKARI-01.jpg", width");
}

dummy {
  background-color: transparent;
}

textbox-help {
    expand: false;
    content: " [ CTRL DEL ]    ELMINAR                [ ALT DEL ]   ELMINAR TODO";

    border-radius:                 15px;
    background-color:              @background-alt;
    text-color:                    @selected-urgent-background;

    margin:                        0px;
    padding:                       20px;
}

entry {
    cursor:                      inherit;
    placeholder:                 "SELECIONA Y COPIA";
    placeholder-color:         #FFFFFF80;
    border-radius:               10px;
    background-color:            @background-alt;
    padding:                     15px 25px;
}

listview {
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

listview {
    cursor:                      "default";
    columns:                     2;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    background-color:            transparent;
    text-color:                  @foreground;

    spacing:                     12px;
    margin:                      0px;
    padding:                     5px;
}

element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     12px;
    border-radius:               5px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}

element normal.urgent {
    background-color:            @urgent;
    text-color:                  @foreground;
}

element normal.active {
    background-color:            @active;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @foreground;
}

element selected.urgent {
    background-color:            @urgent;
    text-color:                  @foreground;
}

element selected.active {
    background-color:            @urgent;
    text-color:                  @foreground;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

message {
    background-color:            transparent;
}

textbox {
    padding:                     12px;
    border-radius:               5px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     15px;
    border-radius:               0px;
    background-color:            @background;
    text-color:                  @foreground;
}
