{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/assets/Mizuhara.jpg",
        "type": "kitty",
        "height": 22,
        "padding": {
            "top": 4
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m󰊠  \u001b[31m󰮔  \u001b[32m󰚌  \u001b[33m󰤇  \u001b[34m󱇪  \u001b[35m󱟓  \u001b[36m󰢚  \u001b[37m󰮇 "
        },
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": "󰣇 ",
            "keyColor": "34"
        },
        {
            "type": "host",
            "key": "󰟀 ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": "󰅐 ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m󰫢  \u001b[31m󰫢  \u001b[32m󰫢  \u001b[33m󰫢  \u001b[34m󰫢  \u001b[35m󰫢  \u001b[36m󰫢  \u001b[37m󰫢 "
        },
        "break",
        {
            "type": "display",
            "key": "󰍹 ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "󰍹 ",
            "keyColor": "34"
        },
        {
            "type": "theme",
            "key": "󰉼 ",
            "keyColor": "34"
        },
        {
            "type": "icons",
            "key": "󰀻 ",
            "keyColor": "34"
        },
        {
            "type": "font",
            "key": "󰛖 ",
            "keyColor": "34"
        },
        {
            "type": "cursor",
            "key": "󰇀 ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m󰊠  \u001b[31m󰮔  \u001b[32m󰚌  \u001b[33m󰤇  \u001b[34m󱇪  \u001b[35m󱟓  \u001b[36m󰢚  \u001b[37m󰮇 "
        },
        "break",
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "key": "󰢮 ",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "format": "{3} (AMD)",
            "key": "󰢮 ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "34"
        },
        {
            "type": "swap",
            "key": "󰓡 ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m󰊠  \u001b[31m󰮔  \u001b[32m󰚌  \u001b[33m󰤇  \u001b[34m󱇪  \u001b[35m󱟓  \u001b[36m󰢚  \u001b[37m󰮇 "
        },
        "break",
        {
            "type": "localip",
            "key": "󰩟 ",
            "keyColor": "34"
        },
        {
            "type": "battery",
            "key": "󰁹 ",
            "keyColor": "34"
        },
        {
            "type": "locale",
            "key": "󰗊 ",
            "keyColor": "34"
        },
        {
            "type": "media",
            "key": " ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m󰫢  \u001b[31m󰫢  \u001b[32m󰫢  \u001b[33m󰫢  \u001b[34m󰫢  \u001b[35m󰫢  \u001b[36m󰫢  \u001b[37m󰫢 "
        }
    ]
}
