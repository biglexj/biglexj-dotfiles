{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/assets/Mizuhara.jpg",
    	"type": "kitty",
    	"height": 22,
    	"padding": {
    		"top": 4
    	}
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
        "break",
        "break",
	{
            "type": "custom",
            "format": "\u001b[90m󰊠  \u001b[31m󰮔  \u001b[32m󰚌  \u001b[33m󰤇  \u001b[34m󱇪  \u001b[35m󱟓  \u001b[36m󰢚  \u001b[37m󰮇 "
        },
	"break",
	{
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "34",  // = color4
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "34",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "34",  
        },
        {
            "type": "display",
            "key": "󰍹  ",
            "keyColor": "34",
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "34", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "34", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "34", 
        },
        {
            "type": "terminalfont",
            "key": " ",
            "keyColor": "34", 
        },
        {
            "type": "media",
            "key": " ",
            "keyColor": "34", 
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m󰫢  \u001b[31m󰫢  \u001b[32m󰫢  \u001b[33m󰫢  \u001b[34m󰫢  \u001b[35m󰫢  \u001b[36m󰫢  \u001b[37m󰫢 "
        },
        "break",
        {
            "type": "cpu",
            "format": "{1}",
            "key": " CPU",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "key": " GPU",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": " GPU Driver",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": "﬙ Memory",
            "keyColor": "34"
        },
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m󰊠  \u001b[31m󰮔  \u001b[32m󰚌  \u001b[33m󰤇  \u001b[34m󱇪  \u001b[35m󱟓  \u001b[36m󰢚  \u001b[37m󰮇 "
        },
    ]
}
